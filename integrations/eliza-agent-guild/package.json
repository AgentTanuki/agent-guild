{
	"name": "elizaos-plugin-agent-guild",
	"version": "0.1.0-dev.0",
	"description": "Explicit public endpoint observations and operator-supplied passport verification for elizaOS",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
